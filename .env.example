# ============================================================================
# SIA AI AGENT - ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT commit production values to source control.
# Configure these in your Vercel & Supabase Cloud Dashboards.
# ============================================================================

# NEXT.js & PUBLIC APPLICATION URL
NEXT_PUBLIC_APP_URL=https://app.sia.ai

# SUPABASE (Client & Server Authentication + Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CRYPTOGRAPHIC SECURITY (AES-256-GCM Token Encryption & HMAC Signatures)
# Must be a 64-character hexadecimal string (32 bytes / 256 bits)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
UNSUBSCRIBE_SECRET_KEY=your-unsubscribe-hmac-signing-secret

# GOOGLE GEMINI AI (Advisory Generation & Reply Classification)
GEMINI_API_KEY=your-google-gemini-api-key

# GOOGLE CLOUD OAUTH 2.0 (Gmail API Integration)
# Authorized Scopes: gmail.send, gmail.readonly, userinfo.email
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://app.sia.ai/api/auth/gmail/callback

# BACKGROUND CRON & DISPATCH SECURITY
CRON_SECRET=your-secure-cron-authorization-secret
